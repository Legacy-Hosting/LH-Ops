BACKUP_NAME=sso
DB_HOST=managed-mysql-host
DB_PORT=25060
DB_NAME=legacyhosting_sso
DB_USER=sso-backup-user
DB_PASSWORD=
DB_SSL_CA=/etc/ssl/certs/digitalocean-mysql-ca.pem
DB_ADMIN_USER=sso-restore-user
DB_ADMIN_PASSWORD=
BACKUP_AGE_RECIPIENT=age1replace
BACKUP_AGE_IDENTITY=/etc/legacy-hosting/backup-age-key.txt
BACKUP_RETENTION_DAYS=14
RESTORE_DATABASE_PREFIX=lh_sso_restore_drill
MIGRATION_TABLE=sso_schema_migrations
