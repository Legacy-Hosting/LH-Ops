BACKUP_NAME=api
DB_HOST=managed-mysql-host
DB_PORT=25060
DB_ADMIN_USER=api-restore-user
DB_ADMIN_PASSWORD=
DB_SSL_CA=/etc/ssl/certs/digitalocean-mysql-ca.pem
BACKUP_AGE_IDENTITY=/etc/legacy-hosting/restore/backup-age-key.txt
RESTORE_DATABASE_PREFIX=lh_api_restore_drill
MIGRATION_TABLE=schema_migrations
RESTORE_REQUIRED_TABLES="users teams applications deployments audit_events"
