# Install only for a restore as /etc/legacy-hosting/application-backups/APPLICATION-restore.env with mode 0600.
APPLICATION_ID=00000000-0000-4000-8000-000000000000
APPLICATION_NAME=customer-app
APPLICATION_STORAGE_PATH=/home/customer.example/customer-app.example
PERSISTENT_PATHS_FILE=/etc/legacy-hosting/application-backups/APPLICATION.paths
APPLICATION_PM2_PROCESSES="customer-app-web customer-app-worker"
BACKUP_AGE_IDENTITY=/etc/legacy-hosting/restore/application-backup-age-key.txt
