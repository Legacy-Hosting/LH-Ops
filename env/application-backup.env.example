# Install as /etc/legacy-hosting/application-backups/APPLICATION.env with mode 0600.
APPLICATION_ID=00000000-0000-4000-8000-000000000000
APPLICATION_NAME=customer-app
APPLICATION_STORAGE_PATH=/home/customer.example/customer-app.example
PERSISTENT_PATHS_FILE=/etc/legacy-hosting/application-backups/APPLICATION.paths
BACKUP_AGE_RECIPIENT=age1replace
BACKUP_LOCAL_RETENTION_DAYS=2
BACKUP_S3_ENDPOINT=fra1.digitaloceanspaces.com
BACKUP_S3_BUCKET=legacy-hosting-application-backups
BACKUP_S3_PREFIX=applications
BACKUP_S3_ACCESS_KEY_ID=replace-with-scoped-spaces-key
BACKUP_S3_SECRET_ACCESS_KEY=replace-with-scoped-spaces-secret
