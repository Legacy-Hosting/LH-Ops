BACKUP_NAME=api
DB_HOST=managed-mysql-host
DB_PORT=25060
DB_NAME=legacyhosting
DB_USER=api-backup-user
DB_PASSWORD=
DB_SSL_CA=/etc/ssl/certs/digitalocean-mysql-ca.pem
DB_ADMIN_USER=api-restore-user
DB_ADMIN_PASSWORD=
BACKUP_AGE_RECIPIENT=age1replace
BACKUP_AGE_IDENTITY=/etc/legacy-hosting/backup-age-key.txt
BACKUP_RETENTION_DAYS=14
RESTORE_DATABASE_PREFIX=lh_api_restore_drill
MIGRATION_TABLE=schema_migrations
