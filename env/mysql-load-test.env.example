# Install as /etc/legacy-hosting/load-tests/NAME.env with mode 0600.
# Use a dedicated SELECT-only user and never an application or admin account.
LOAD_TEST_NAME=api-read-capacity
DB_HOST=managed-mysql-host
DB_PORT=25060
DB_NAME=legacyhosting_api
DB_USER=api_load_test_readonly
DB_PASSWORD=replace-with-read-only-password
DB_SSL_CA=/etc/legacy-hosting/load-tests/managed-mysql-ca.crt
DB_QUERY_FILE=/etc/legacy-hosting/load-tests/api-read.sql
DB_CONCURRENCY=5
DB_QUERIES_PER_WORKER=200
MINIMUM_QUERIES_PER_SECOND=50
MAXIMUM_TOTAL_SECONDS=20
